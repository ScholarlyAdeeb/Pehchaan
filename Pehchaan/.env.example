# Copy to `.env` in this folder. Never commit the real `.env`.
# On a checkpoint machine the secrets below are generated on first start
# (server/bootstrap-secrets.ts). On hosted deployments (Vercel) set every one
# of them in the project's environment; the gateway refuses to start without.

# Postgres connection string (Neon: Dashboard -> Connection Details).
# Leave empty to run with an in-memory store (data is lost on restart).
NEON_DATABASE_URL=

# ---- Secrets ---------------------------------------------------------------
JWT_SECRET=            # signs session tokens
HMAC_SECRET=           # signs audit entries and seals the offline sign-in cache
ENGINE_API_KEY=        # must equal ENGINE_API_KEY in backend/.env
PII_HASH_KEY=          # must equal PII_HASH_KEY in backend/.env
ANCHOR_SIGNING_KEY=    # base64 of an Ed25519 private key (PEM); signs batch roots

# ---- Screening engine link ---------------------------------------------------
# Unset on a checkpoint machine: https://127.0.0.1:8000 when backend/certs exists
# (python -m scripts.make_tls_certs), otherwise http://127.0.0.1:8000.
# Hosted gateway: the engine's public https URL, plus the three certificate
# values printed by `python -m scripts.make_tls_certs --host <engine host> --print-env`.
PYTHON_API_URL=
ENGINE_CA_CERT=
ENGINE_CLIENT_CERT=
ENGINE_CLIENT_KEY=

# ---- Hyperledger Fabric anchoring (optional) -----------------------------------
# Unset on a machine that ran `bash fabric/network.sh up`: the local network is
# found automatically. For a remote peer set all of these (PEM text, base64 of
# the PEM, or a file path). FABRIC_ANCHORING=off disables anchoring.
FABRIC_PEER_ENDPOINT=      # host:port of the gateway peer
FABRIC_PEER_HOST_ALIAS=    # name on the peer's TLS certificate, if it differs from the host
FABRIC_MSP_ID=
FABRIC_TLS_CERT=
FABRIC_CLIENT_CERT=
FABRIC_CLIENT_KEY=
FABRIC_CHANNEL=pehchaan
FABRIC_CHAINCODE=auditledger
FABRIC_SOURCE=pehchaan     # identifies this deployment's batches on the ledger

# ---- Checkpoint (offline) behaviour: ignored on Vercel --------------------------
OUTBOX_SYNC_SECONDS=30     # how often queued records are replayed
OFFLINE_LOGIN_DAYS=7       # how long after an online sign-in an account may sign in offline

# ---- Serverless hosting -------------------------------------------------------
CRON_SECRET=               # Vercel Cron authenticates to /api/cron/maintenance with this

# Shared demo accounts shown on the sign-in page (protected from lock-out).
# Default: the three published demo emails. Set to none for a real deployment.
# DEMO_ACCOUNTS=none
# Hide the sign-in sticky note in the build:
# VITE_SHOW_DEMO_LOGINS=false
