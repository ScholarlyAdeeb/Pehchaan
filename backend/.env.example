# Copy this file to `.env` and adjust as needed. All values have defaults
# in app/config.py, so an empty .env works (without the records cross-check).

APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Full path to tesseract.exe if it's not on your PATH, e.g. on Windows:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

MAX_UPLOAD_MB=12

# Same Postgres database as Pehchaan/.env. Used to compare each document with
# earlier screenings of the same document number. Empty = compare only with
# scans made since this process started.
NEON_DATABASE_URL=

# Document region detector (Faster R-CNN). Used automatically when the model file
# exists; its readings are merged into the full-page OCR only on known card layouts.
# LOCALIZATION_MODEL_PATH=models/localization/region_detector.pt   (default; trained by training/train_region_detector.py)
LOCALIZATION_CONFIDENCE=0.5
LOCALIZATION_DEVICE=auto
LOCALIZATION_ENABLED=true

# Auto-detection: minimum classifier confidence to trust it without text evidence
CLASSIFIER_MIN_CONFIDENCE=0.60

# Tampering detection tuning
ELA_JPEG_QUALITY=90
ELA_SUSPICION_THRESHOLD=18.0
# Keypoint pairs sharing one displacement before copy-move is flagged
# (printed documents reach ~80 from repeated glyphs, so the alarm sits at 100)
COPY_MOVE_MATCH_THRESHOLD=100

# Face verification thresholds are calibrated per backend in app/modules/face/verifier.py

# Records cross-check: name similarity below this = different holder
RECORDS_NAME_MATCH_THRESHOLD=0.75

# Risk engine weights (rescaled over the signals that actually ran)
WEIGHT_VALIDATION=0.30
WEIGHT_TAMPERING=0.35
WEIGHT_FACE=0.20
WEIGHT_RECORDS=0.15

RISK_CLEAR_MAX=30
RISK_REVIEW_MAX=65

# --- Security ---
# ENGINE_API_KEY=  # Shared with web server; every /api call must carry x-engine-key header
# AUTH_SECRET_KEY=  # Auto-generated if missing; used for JWT/session tokens
# AUDIT_SIGNING_KEY=  # Auto-generated if missing; used for audit log signatures
# PII_HASH_KEY=  # Keyed HMAC for document numbers (DPDP Act); must be set for production
# ADMIN_BOOTSTRAP_CODE=  # One-time code to create the first admin; DELETE AFTER USE
# MAX_IMAGE_PIXELS=60000000

# Checkpoint access control (comma-separated). Empty = allow all.
# ENGINE_CHECKPOINT_IDS=CP001,CP002

# Retention & Incident
# SCAN_RETENTION_DAYS=90
# INCIDENT_REPORT_WEBHOOK=https://your-webhook.example.com/incident

# Timestamping (optional public timestamping of scan receipts)
# TIMESTAMP_AUTHORITY_URL=https://timestamp.example.com
# TIMESTAMP_AUTHORITY_TOKEN=