{
  "name": "pehchaan-mobile",
  "private": true,
  "version": "1.1.1",
  "description": "Android shell for the PEHCHAAN dashboard",
  "scripts": {
    "sync": "cap sync android",
    "icons": "capacitor-assets generate --android --iconBackgroundColor #0a203b --iconBackgroundColorDark #0a203b --splashBackgroundColor #0a203b --splashBackgroundColorDark #0a203b",
    "build": "cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
