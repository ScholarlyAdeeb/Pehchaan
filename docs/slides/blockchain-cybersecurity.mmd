    %% ===== STYLES =====
    classDef coreLayer fill:#0059b5,stroke:#0059b5,stroke-width:0,color:#fff,font-weight:700,rx:10,ry:10,padding:14px 20px,font-size:15px
    classDef chainLayer fill:#006a26,stroke:#006a26,stroke-width:0,color:#fff,font-weight:700,rx:10,ry:10,padding:14px 20px,font-size:15px
    classDef auditLayer fill:#5f5e60,stroke:#5f5e60,stroke-width:0,color:#fff,font-weight:700,rx:10,ry:10,padding:14px 20px,font-size:15px
    classDef cryptoLayer fill:#e8a000,stroke:#e8a000,stroke-width:0,color:#1a1b1f,font-weight:700,rx:10,ry:10,padding:14px 20px,font-size:15px
