new file mode 100644
index 0000000..a954d24
--- /dev/null
+++ b/backend/app/modules/records/face_index.py
@@ -0,0 +1,143 @@
+"""
+One face, two identities.
+
+The records check catches one document number shown under two names. It
+cannot see the opposite fraud, which the problem statement lists by name:
+one person carrying several identities. Each forged card has its own number,
+so number lookups never connect them. The face does: a forger puts their own
+photo on every card.
+
+Every screening's document portrait is stored here as a 128-number SFace
+embedding (not the image), next to the holder details read off that card.
+A new portrait is compared with all of them. A close face with the same name
+and date of birth is the same person on another document (a passport today,
+an Aadhaar last week) and is only noted. A close face under a different name
+or date of birth is the fraud.
+
+Searching one face against N stored faces makes chance matches N times more
+likely than in a 1:1 check, so the bar here sits well above the 1:1 match
+band (0.45), and only very close faces raise a critical issue.
+
+Storage is a local SQLite file on the checkpoint machine. A linear scan
+over 100k faces is ~50 MB of vectors and a few milliseconds of numpy, which
+is plenty for one post. Rows expire with the scan retention period.
+"""
+from __future__ import annotations
+
+import logging
+import sqlite3
+import threading
+import time
+from collections.abc import Iterator
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import numpy as np
+
+from app.config import get_settings
+from app.modules.records.crosscheck import _name_similarity
+from app.modules.records.pii import hash_document_number, mask_document_number
+
+logger = logging.getLogger(__name__)
+
+_lock = threading.Lock()
+
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS faces (
+    scan_id     TEXT PRIMARY KEY,
+    doc_hash    TEXT,
+    doc_masked  TEXT,
+    doc_type    TEXT,
+    name        TEXT,
+    dob         TEXT,
+    embedding   BLOB NOT NULL,
+    created_at  REAL NOT NULL
+)
+"""
+
+
+@dataclass
+class FaceHit:
+    scan_id: str
+    similarity: float
+    doc_masked: str | None
+    doc_type: str | None
+    name: str | None
+    dob: str | None
+
+
+@dataclass
+class FaceReuseResult:
+    checked: bool = False
+    conflicts: list[FaceHit] = field(default_factory=list)  # same face, different holder details
+    linked: list[FaceHit] = field(default_factory=list)  # same face, same holder, other document
+
+
+@contextmanager
+def _connect(path: Path | None = None) -> Iterator[sqlite3.Connection]:
+    path = path or get_settings().FACE_INDEX_PATH
+    path.parent.mkdir(parents=True, exist_ok=True)
+    conn = sqlite3.connect(path)
+    try:
+        conn.execute(_SCHEMA)
+        yield conn
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def remember(scan_id: str, embedding: np.ndarray | None, *, doc_number: str | None, doc_type: str | None,
+             name: str | None, dob: str | None, path: Path | None = None) -> None:
+    if embedding is None:
+        return
+    vec = np.asarray(embedding, dtype=np.float32).ravel()
+    with _lock, _connect(path) as conn:
+        conn.execute(
+            "INSERT OR REPLACE INTO faces VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+            (scan_id, hash_document_number(doc_number), mask_document_number(doc_number), doc_type,
+             name, dob, vec.tobytes(), time.time()),
+        )
+
+
+def _same_holder(hit: FaceHit, name: str | None, dob: str | None) -> bool:
+    if hit.dob and dob and hit.dob.strip() != dob.strip():
+        return False
+    return _name_similarity(hit.name, name) >= get_settings().RECORDS_NAME_MATCH_THRESHOLD
+
+
+def search(embedding: np.ndarray | None, *, doc_number: str | None, name: str | None, dob: str | None,
+           path: Path | None = None) -> FaceReuseResult:
+    if embedding is None:
+        return FaceReuseResult()
+
+    with _lock, _connect(path) as conn:
+        rows = conn.execute(
+            "SELECT scan_id, doc_hash, doc_masked, doc_type, name, dob, embedding FROM faces").fetchall()
+    if not rows:
+        return FaceReuseResult(checked=True)
+
+    stored = np.frombuffer(b"".join(r[6] for r in rows), dtype=np.float32).reshape(len(rows), -1)
+    query = np.asarray(embedding, dtype=np.float32).ravel()
+    scores = stored @ query  # all vectors are unit length, so this is cosine similarity
+
+    bar = get_settings().FACE_REUSE_SIMILARITY
+    this_doc = hash_document_number(doc_number)
+    result = FaceReuseResult(checked=True)
+    for i in np.argsort(-scores):
+        if scores[i] < bar:
+            break
+        scan_id, doc_hash, doc_masked, doc_type, prior_name, prior_dob, _ = rows[i]
+        if this_doc and doc_hash == this_doc:
+            continue  # the same document screened again: the number check already covers it
+        hit = FaceHit(scan_id, round(float(scores[i]), 3), doc_masked, doc_type, prior_name, prior_dob)
+        (result.linked if _same_holder(hit, name, dob) else result.conflicts).append(hit)
+    return result
+
+
+def forget_older_than(days: int, dry_run: bool = False, path: Path | None = None) -> int:
+    cutoff = time.time() - days * 86400
+    with _lock, _connect(path) as conn:
+        if dry_run:
+            return conn.execute("SELECT COUNT(*) FROM faces WHERE created_at < ?", (cutoff,)).fetchone()[0]
+        return conn.execute("DELETE FROM faces WHERE created_at < ?", (cutoff,)).rowcount
