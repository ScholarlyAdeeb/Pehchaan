+++ b/backend/tests/test_portrait_ela.py
@@ -0,0 +1,100 @@
+"""Photo-swap detection: portrait ELA against the rest of the card.
+
+The cards here are drawn, not generated by cardgen, so the test runs without
+the dataset. The point is the separation, not the exact numbers; real
+calibration is training/eval_portrait_ela.py.
+"""
+import cv2
+import numpy as np
+import pytest
+
+from app.config import get_settings
+from app.modules.tampering.ela import portrait_error_ratio, run_ela
+from app.modules.tampering.tampering_engine import analyze_tampering, check_portrait, portrait_box
+
+PHOTO = (60, 150, 200, 240)  # x, y, w, h; deliberately off the 8x8 grid, as a paste would be
+FACE = (90, 190, 140, 160)  # what the face detector finds inside that photo
+DETECTED = {"regions": [{"class_name": "photo", "confidence": 0.97,
+                         "bbox": {"x": 60, "y": 150, "w": 200, "h": 240}}]}
+
+
+def _photo(seed: int) -> np.ndarray:
+    rng = np.random.default_rng(seed)
+    coarse = rng.integers(40, 220, (12, 10, 3)).astype(np.uint8)
+    face = cv2.resize(coarse, (200, 240), interpolation=cv2.INTER_CUBIC).astype(np.float64)
+    return np.clip(face + rng.normal(0, 6, face.shape), 0, 255).astype(np.uint8)
+
+
+def _card(seed: int) -> np.ndarray:
+    rng = np.random.default_rng(seed)
+    page = np.full((640, 1000, 3), (235, 228, 215), np.uint8)
+    for line in range(14):
+        cv2.putText(page, f"NAME XYZ 12/04/19{line:02d} {rng.integers(100000)}", (300, 60 + line * 40),
+                    cv2.FONT_HERSHEY_SIMPLEX, 0.9, (30, 30, 60), 2)
+    x, y, w, h = PHOTO
+    page[y:y + h, x:x + w] = _photo(seed + 100)
+    # a phone camera, not a scanner: slight blur and sensor noise
+    page = cv2.GaussianBlur(page, (3, 3), 0.8).astype(np.float64)
+    return np.clip(page + rng.normal(0, 3, page.shape), 0, 255).astype(np.uint8)
+
+
+def _jpeg(image: np.ndarray, quality: int) -> bytes:
+    return cv2.imencode(".jpg", image, [cv2.IMWRITE_JPEG_QUALITY, quality])[1].tobytes()
+
+
+def _decode(data: bytes) -> np.ndarray:
+    return cv2.imdecode(np.frombuffer(data, np.uint8), cv2.IMREAD_COLOR)
+
+
+def _swapped(seed: int, pasted_quality: int = 75) -> bytes:
+    """What a forger does: open the genuine scan, paste a cut-out from another JPEG, save."""
+    page = _decode(_jpeg(_card(seed), 90))
+    x, y, w, h = PHOTO
+    page[y:y + h, x:x + w] = _decode(_jpeg(_photo(seed + 999), pasted_quality))
+    return _jpeg(page, 90)
+
+
+@pytest.mark.parametrize("seed", range(6))
+@pytest.mark.parametrize("box", [PHOTO, portrait_box(None, FACE)], ids=["detector-box", "grown-face-box"])
+def test_pasted_photo_stands_out_and_genuine_does_not(seed, box):
+    limit = get_settings().PORTRAIT_ELA_RATIO_LIMIT
+    genuine = portrait_error_ratio(_jpeg(_card(seed), 90), box)
+    forged = portrait_error_ratio(_swapped(seed), box)
+    assert genuine < limit * 0.9  # not even in the "worth a look" band
+    assert forged >= limit
+
+
+def test_the_detector_photo_box_wins_over_the_face_and_weak_boxes_are_ignored():
+    assert portrait_box(DETECTED, FACE) == PHOTO
+    weak = {"regions": [{**DETECTED["regions"][0], "confidence": 0.2}]}
+    assert portrait_box(weak, FACE) == portrait_box(None, FACE)
+    assert portrait_box(None, None) is None
+
+
+def test_page_wide_ela_misses_the_swap_that_the_portrait_check_catches():
+    forged = _swapped(1)
+    assert not run_ela(forged, generate_heatmap=False).suspicious  # the gap this check closes
+
+    result = check_portrait(analyze_tampering(forged, _decode(forged)), forged, portrait_box(DETECTED, FACE))
+    assert result.verdict == "tampered"
+    assert result.tampering_score >= 60
+    assert result.evidence[0].startswith("The photo re-compresses")
+    assert result.components[-1]["weight"] == "floor"
+
+
+def test_a_genuine_card_shared_twice_is_not_called_a_swap():
+    reshared = _jpeg(_decode(_jpeg(_decode(_jpeg(_card(2), 90)), 80)), 70)
+    result = check_portrait(analyze_tampering(reshared, _decode(reshared)), reshared, portrait_box(None, FACE))
+    assert result.verdict == "clean"
+    assert result.components[-1]["raw"] == 0
+
+
+def test_no_portrait_or_a_flat_box_leaves_the_result_alone():
+    data = _jpeg(_card(3), 90)
+    before = analyze_tampering(data, _decode(data))
+    score = before.tampering_score
+    assert check_portrait(before, data, None).tampering_score == score
+
+    blank = np.full((400, 600, 3), 230, np.uint8)
+    blank_bytes = _jpeg(blank, 90)
+    assert portrait_error_ratio(blank_bytes, (20, 20, 100, 120)) is None
