index 0000000..3bbc0d4
--- /dev/null
+++ b/backend/training/eval_portrait_ela.py
@@ -0,0 +1,142 @@
+"""
+Measure photo-swap detection on the generated cards, and pick the alarm level.
+
+For every person and card type, three images are scored:
+  genuine     the card as generated
+  reshared    the same card squeezed through two more JPEG saves (q80, q70),
+              as a WhatsApp forward would do; this must NOT look like a swap
+  swapped     the next person's photo pasted over the holder's, after its own
+              JPEG round trip (q60 / q75 / q95), then saved at q90, the way
+              scripts/make_demo_samples.py makes demo_dl_photo_swap.jpg
+
+Each image gets the page-wide ELA verdict (what the engine had before) and the
+portrait ratio (tampering/ela.py: portrait_error_ratio), measured in the photo
+box from the generator's annotation.
+
+The suggested alarm is the midpoint between the highest genuine/reshared
+ratio and the lowest swapped one, if they do not overlap.
+
+Usage (from backend/):
+    .venv\\Scripts\\python training\\eval_portrait_ela.py [--people 300] [--data training/data_generated]
+Output: training/portrait_ela_eval.json, and a summary on screen
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import sys
+from collections import defaultdict
+from datetime import datetime
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+DATA = HERE / "data_generated"
+OUT = HERE / "portrait_ela_eval.json"
+DOC_TYPES = ("aadhar", "pan", "driving_license", "passport")
+PASTE_QUALITIES = (60, 75, 95)
+
+from app.modules.tampering.ela import portrait_error_ratio, run_ela  # noqa: E402
+
+
+def load(data_dir: Path, doc: str, person: int) -> tuple[bytes, np.ndarray, tuple[int, int, int, int]] | None:
+    stem = f"{doc}_{person:04d}"
+    image_path, ann_path = data_dir / doc / f"{stem}.jpg", data_dir / "annotations" / doc / f"{stem}.json"
+    if not image_path.is_file() or not ann_path.is_file():
+        return None
+    ann = json.loads(ann_path.read_text(encoding="utf-8"))
+    photo = next((r["bbox"] for r in ann["regions"] if r["kind"] == "photo"), None)
+    if photo is None:
+        return None
+    data = image_path.read_bytes()
+    return data, cv2.imdecode(np.frombuffer(data, np.uint8), cv2.IMREAD_COLOR), (
+        photo["x"], photo["y"], photo["w"], photo["h"])
+
+
+def jpeg(image: np.ndarray, quality: int) -> bytes:
+    return cv2.imencode(".jpg", image, [cv2.IMWRITE_JPEG_QUALITY, quality])[1].tobytes()
+
+
+def decode(data: bytes) -> np.ndarray:
+    return cv2.imdecode(np.frombuffer(data, np.uint8), cv2.IMREAD_COLOR)
+
+
+def swap(page: np.ndarray, box, donor: np.ndarray, donor_box, quality: int) -> bytes:
+    x, y, w, h = box
+    dx, dy, dw, dh = donor_box
+    patch = cv2.resize(donor[dy:dy + dh, dx:dx + dw], (w, h), interpolation=cv2.INTER_AREA)
+    forged = page.copy()
+    forged[y:y + h, x:x + w] = decode(jpeg(patch, quality))
+    return jpeg(forged, 90)
+
+
+def score(data: bytes, box) -> tuple[float | None, bool]:
+    return portrait_error_ratio(data, box), run_ela(data, generate_heatmap=False).suspicious
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--people", type=int, default=300)
+    parser.add_argument("--data", type=Path, default=DATA)
+    args = parser.parse_args()
+
+    # kind -> doc type -> list of (ratio, page-wide ELA flagged)
+    seen: dict[str, dict[str, list]] = defaultdict(lambda: defaultdict(list))
+    for doc in DOC_TYPES:
+        for person in range(1, args.people + 1):
+            card, donor = load(args.data, doc, person), load(args.data, doc, person + 1 if person < args.people else 1)
+            if card is None or donor is None:
+                continue
+            data, page, box = card
+            seen["genuine"][doc].append(score(data, box))
+            seen["reshared"][doc].append(score(jpeg(decode(jpeg(page, 80)), 70), box))
+            for q in PASTE_QUALITIES:
+                seen["swapped"][doc].append(score(swap(page, box, donor[1], donor[2], q), box))
+        print(f"{doc}: {len(seen['genuine'][doc])} cards")
+
+    if not any(seen["genuine"].values()):
+        raise SystemExit(f"No cards under {args.data}; generate the dataset first (scripts/cardgen/generate.py).")
+
+    report: dict = {"created": datetime.now().isoformat(timespec="seconds"), "per_type": {}}
+    for doc in DOC_TYPES:
+        if not seen["genuine"][doc]:
+            continue
+        clean = [r for kind in ("genuine", "reshared") for r, _ in seen[kind][doc] if r is not None]
+        forged = [r for r, _ in seen["swapped"][doc] if r is not None]
+        top_clean, low_forged = max(clean), min(forged)
+        alarm = round((top_clean + low_forged) / 2, 2) if top_clean < low_forged else None
+        report["per_type"][doc] = {
+            "genuine_ratio_range": [min(clean), top_clean],
+            "swapped_ratio_range": [low_forged, max(forged)],
+            "suggested_alarm": alarm,
+            "page_wide_ela_catches_swaps": f"{sum(f for _, f in seen['swapped'][doc])}/{len(seen['swapped'][doc])}",
+            "page_wide_ela_false_alarms": f"{sum(f for k in ('genuine', 'reshared') for _, f in seen[k][doc])}"
+                                          f"/{len(seen['genuine'][doc]) + len(seen['reshared'][doc])}",
+        }
+
+    # One alarm for all types: the engine has a single setting.
+    alarms = [v["suggested_alarm"] for v in report["per_type"].values()]
+    if all(a is not None for a in alarms):
+        clean_top = max(v["genuine_ratio_range"][1] for v in report["per_type"].values())
+        forged_low = min(v["swapped_ratio_range"][0] for v in report["per_type"].values())
+        report["suggested_PORTRAIT_ELA_RATIO_LIMIT"] = (
+            round((clean_top + forged_low) / 2, 2) if clean_top < forged_low else None)
+
+    limit = report.get("suggested_PORTRAIT_ELA_RATIO_LIMIT")
+    if limit is not None:
+        caught = sum(r is not None and r >= limit for doc in DOC_TYPES for r, _ in seen["swapped"][doc])
+        total = sum(len(seen["swapped"][doc]) for doc in DOC_TYPES)
+        report["portrait_check_catches_swaps"] = f"{caught}/{total}"
+
+    OUT.write_text(json.dumps(report, indent=2), encoding="utf-8")
+    print(json.dumps(report, indent=2))
+    if report.get("suggested_PORTRAIT_ELA_RATIO_LIMIT") is None:
+        print("\nGenuine and swapped ratios overlap on at least one card type: look at per_type before "
+              "choosing an alarm, and say so in the README rather than picking a number that hides it.")
