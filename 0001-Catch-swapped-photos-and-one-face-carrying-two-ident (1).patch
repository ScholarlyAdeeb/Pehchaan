+def face_embedding(face: np.ndarray | None) -> np.ndarray | None:
+    """Unit-length SFace embedding of one face, for searching earlier screenings.
+
+    Only the SFace network is used: its scores are calibrated (see _BANDS) and
+    the fallback is not a recognition model, so its vectors would match anyone.
+    """
+    if face is None or _sface is None:
+        return None
+    try:
+        vec = _sface._embed(face).astype(np.float32).ravel()
+    except cv2.error:
+        return None
+    norm = float(np.linalg.norm(vec))
+    return vec / norm if norm > 0 else None
+
+
 def active_backend() -> str:
     return "sface" if _sface is not None else "dlib" if _DLIB else "fallback"
 
