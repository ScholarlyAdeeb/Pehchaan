+def _verdict(score: int) -> str:
+    if score < 20:
+        return "clean"
+    if score < 55:
+        return "suspicious"
+    return "tampered"
+
+
+def portrait_box(region_detection: dict | None,
+                 face_box: tuple[int, int, int, int] | None) -> tuple[int, int, int, int] | None:
+    """The whole printed photo, edges included: that is where a paste seam sits.
+
+    The field detector's "photo" box is the photo frame itself, so it is used
+    when the layout was recognised. Otherwise the face box is grown out to an
+    ID-photo frame: some background either side, the hair above, the
+    shoulders below. A bare face box sits inside the photo and misses the seam.
+    """
+    photos = [r for r in (region_detection or {}).get("regions", [])
+              if r.get("class_name") == "photo" and r.get("confidence", 0) >= 0.5]
+    if photos:
+        b = max(photos, key=lambda r: r.get("confidence", 0))["bbox"]
+        return b["x"], b["y"], b["w"], b["h"]
+    if face_box is None:
+        return None
+    x, y, w, h = face_box
+    return x - int(w * 0.35), y - int(h * 0.3), int(w * 1.7), int(h * 1.8)
+
+
+def check_portrait(result: TamperingResult, image_bytes: bytes,
+                   box: tuple[int, int, int, int] | None) -> TamperingResult:
+    """Look for a swapped photo, once the portrait has been found.
+
+    Photo replacement is the most common forgery on a card, and the page-wide
+    ELA above misses it (the portrait is too small a share of the page). So a
+    clear portrait signal sets the floor of the forensics score instead of
+    being averaged in with signals that cannot see it.
+    """
+    if box is None:
+        return result
+    ratio = portrait_error_ratio(image_bytes, box)
+    if ratio is None:
+        return result
+
+    limit = get_settings().PORTRAIT_ELA_RATIO_LIMIT
+    near = limit * 0.9
+    if ratio >= limit:
+        raw = min(100.0, 60.0 + (ratio - limit) * 10.0)
+        result.evidence.insert(0, (
+            f"The photo re-compresses {ratio:.1f}x as hard as the rest of the card (alarm at {limit:.1f}x): "
+            f"it has a different compression history from the printed page, as a pasted-in photo does."
+        ))
+    elif ratio >= near:
+        raw = 35.0
+        result.evidence.append(
+            f"The photo re-compresses {ratio:.1f}x as hard as the rest of the card, just under the "
+            f"{limit:.1f}x alarm. Worth a look at the photo edges under a loupe."
+        )
+    else:
+        raw = 0.0
+
+    result.components.append({
+        "name": "Portrait vs card (photo swap)",
+        "raw": round(raw, 1),
+        "weight": "floor",
+        "contribution": round(raw, 1),
+        "how": (f"ELA error per unit of edge strength, inside the photo / rest of the card = {ratio:.2f}x; "
+                f"0 below {near:.1f}x, 35 up to {limit:.1f}x, then 60 + 10 per extra 1x, capped at 100; "
+                f"the forensics score is at least this value"),
+    })
+
+    if raw > result.tampering_score:
+        result.tampering_score = int(round(raw))
+        result.verdict = _verdict(result.tampering_score)
+        result.evidence = [e for e in result.evidence if not e.startswith("No tampering indicators")]
+    return result
