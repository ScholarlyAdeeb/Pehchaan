@@ -0,0 +1,74 @@
+"""One face, two identities: the face index across screenings."""
+import numpy as np
+import pytest
+
+from app.config import get_settings
+from app.modules.records import face_index
+
+
+def _unit(vec: np.ndarray) -> np.ndarray:
+    return (vec / np.linalg.norm(vec)).astype(np.float32)
+
+
+def _face(seed: int) -> np.ndarray:
+    return _unit(np.random.default_rng(seed).normal(size=128))
+
+
+def _same_face_new_photo(face: np.ndarray, seed: int, closeness: float = 0.85) -> np.ndarray:
+    """Another photo of the same person: mostly the same vector, plus a little of something else."""
+    other = np.random.default_rng(seed).normal(size=128)
+    other -= other.dot(face) * face  # make the extra part orthogonal, so cosine == closeness exactly
+    return _unit(closeness * face + np.sqrt(1 - closeness ** 2) * _unit(other))
+
+
+@pytest.fixture
+def index(tmp_path, monkeypatch):
+    monkeypatch.setattr(get_settings(), "PII_HASH_KEY", "test-key", raising=False)
+    path = tmp_path / "faces.sqlite"
+    face_index.remember("scan-1", _face(1), doc_number="ABCDE1234F", doc_type="pan",
+                        name="RAVI KUMAR", dob="12/04/1990", path=path)
+    return path
+
+
+def test_same_face_under_another_name_is_a_conflict(index):
+    result = face_index.search(_same_face_new_photo(_face(1), 7), doc_number="P1234567",
+                               name="SURESH SINGH", dob="12/04/1990", path=index)
+    assert [h.scan_id for h in result.conflicts] == ["scan-1"]
+    assert result.conflicts[0].similarity == pytest.approx(0.85, abs=1e-3)
+    assert result.conflicts[0].doc_masked.endswith("234F")
+
+
+def test_same_person_on_another_document_is_only_linked(index):
+    # a passport today, the PAN last week: same face, name and birth date
+    result = face_index.search(_same_face_new_photo(_face(1), 8), doc_number="P1234567",
+                               name="KUMAR RAVI", dob="12/04/1990", path=index)
+    assert not result.conflicts
+    assert [h.scan_id for h in result.linked] == ["scan-1"]
+
+
+def test_a_different_birth_date_breaks_the_link_even_with_the_same_name(index):
+    result = face_index.search(_same_face_new_photo(_face(1), 9), doc_number="P1234567",
+                               name="RAVI KUMAR", dob="12/04/1982", path=index)
+    assert [h.scan_id for h in result.conflicts] == ["scan-1"]
+
+
+def test_the_same_document_again_is_left_to_the_number_check(index):
+    result = face_index.search(_face(1), doc_number="abcde-1234-f", name="SOMEONE ELSE", dob=None, path=index)
+    assert not result.conflicts and not result.linked
+
+
+def test_a_stranger_and_a_lookalike_below_the_bar_do_not_match(index):
+    assert not face_index.search(_face(2), doc_number="X", name="A B", dob=None, path=index).conflicts
+    lookalike = _same_face_new_photo(_face(1), 10, closeness=0.5)  # above the 1:1 band, below the 1:N bar
+    assert not face_index.search(lookalike, doc_number="X", name="A B", dob=None, path=index).conflicts
+
+
+def test_nothing_to_search_with(index):
+    result = face_index.search(None, doc_number="X", name="A", dob=None, path=index)
+    assert not result.checked
+
+
+def test_rows_expire_with_the_retention_period(index):
+    assert face_index.forget_older_than(1, dry_run=True, path=index) == 0
+    assert face_index.forget_older_than(-1, path=index) == 1  # a cutoff in the future takes everything
+    assert not face_index.search(_face(1), doc_number="Y", name="Z", dob=None, path=index).conflicts
