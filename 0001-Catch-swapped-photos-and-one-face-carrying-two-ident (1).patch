     mean_error = float(diff.mean())
     max_error = float(diff.max()) if diff.size else 0.0
@@ -79,6 +87,44 @@ def run_ela(image_bytes: bytes, quality: int | None = None, generate_heatmap: bo
     )
 
 
+def portrait_error_ratio(image_bytes: bytes, box: tuple[int, int, int, int], quality: int | None = None) -> float | None:
+    """How much harder the portrait re-compresses than the rest of the card.
+
+    Whole-page ELA averages a swapped photo away: a portrait is a few percent
+    of the page, so it rarely crosses the page-wide alarm. Here the error
+    inside the portrait is compared with the error on the rest of the card.
+
+    Raw error grows with detail (sharp edges always re-compress badly), so
+    each side is divided by its own edge strength, and only the more detailed
+    pixels are counted; flat paper says nothing either way. A pasted photo
+    carries its own compression history, usually on a shifted 8x8 grid, and
+    comes out well above a printed one. A genuine card re-shared through
+    WhatsApp is compressed evenly and comes out lower, not higher.
+
+    Returns None when either side has too little detail to judge.
+    """
+    quality = quality or get_settings().ELA_JPEG_QUALITY
+    diff, gray = _error_map(image_bytes, quality)
+    grad = cv2.magnitude(cv2.Sobel(gray.astype(np.float32), cv2.CV_32F, 1, 0),
+                         cv2.Sobel(gray.astype(np.float32), cv2.CV_32F, 0, 1))
+
+    x, y, w, h = box
+    inside = np.zeros(diff.shape, dtype=bool)
+    inside[max(0, y):y + h, max(0, x):x + w] = True
+    detailed = grad > np.percentile(grad, 60)
+
+    def error_per_edge(mask: np.ndarray) -> float | None:
+        if mask.sum() < 200:
+            return None
+        return float(diff[mask].mean() / (grad[mask].mean() + 1.0))
+
+    portrait = error_per_edge(inside & detailed)
+    rest = error_per_edge(~inside & detailed)
+    if portrait is None or not rest:
+        return None
+    return round(portrait / rest, 2)
+
+
 def _render_heatmap(diff: np.ndarray) -> bytes:
     normalized = diff - diff.min()
     max_val = normalized.max()
